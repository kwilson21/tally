{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tally-compare-names",
	"main": "names.ts",
	// The same date as the app's. This Worker is run locally and never deployed.
	"compatibility_date": "2026-09-22",
	// Remote on purpose: each call goes to Cloudflare's models and is billed.
	"ai": { "binding": "AI", "remote": true },
	// Never deployed: no route, no workers.dev address, no preview URLs.
	"workers_dev": false,
	"preview_urls": false
}
