{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"allowJs": true,
		"types": [
			"@cloudflare/vitest-plugin/types",
			"../.cloudflare/types/index.d.ts",
			"vite/client"
		]
	},
	"include": [
		"./**/*.ts",
		"../src/**/*.ts",
		"../src/**/*.tsx",
		"../scripts/**/*.mjs",
		"../scripts/**/*.ts"
	]
}
