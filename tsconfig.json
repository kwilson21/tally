{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "ESNext.Temporal"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"types": ["./.cloudflare/types/index.d.ts"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
