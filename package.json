{
	"name": "tally",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build:css": "tailwindcss -i ./src/styles/app.css -o ./public/assets/app.css --minify",
		"build:vendor": "mkdir -p public/vendor && cp node_modules/htmx.org/dist/htmx.min.js public/vendor/htmx.min.js",
		"build": "npm run build:vendor && npm run build:css",
		"dev": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"hono": "^4.13.8",
		"htmx.org": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/vitest-plugin": "^1.2.3",
		"@tailwindcss/cli": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.136.3"
	}
}
