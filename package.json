{
	"name": "tally",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.20.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build:css": "tailwindcss -i ./src/styles/app.css -o ./public/assets/app.css --minify",
		"build:vendor": "mkdir -p public/vendor && node scripts/patch-htmx.mjs && cp node_modules/html2canvas/dist/html2canvas.min.js public/vendor/html2canvas.min.js",
		"build": "pnpm run build:vendor && pnpm run build:css",
		"dev": "wrangler dev",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:seed:local": "curl -fsS \"http://127.0.0.1:8787/cdn-cgi/handler/scheduled\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"lint": "biome check . && oxlint",
		"format": "biome check --write . && oxlint --fix",
		"lint:slop": "oxlint",
		"test": "vitest run",
		"cutover": "node scripts/cutover-count.mjs",
		"screenshots": "node scripts/screenshots.mjs",
		"e2e": "node scripts/e2e.mjs",
		"test:feedback-preview": "node scripts/feedback-preview-test.mjs",
		"test:feedback-integration": "vitest run --config vitest.feedback.config.ts"
	},
	"dependencies": {
		"drizzle-orm": "0.45.4",
		"hono": "^4.13.8",
		"html2canvas": "^1.4.1",
		"htmx.org": "^4.0.0",
		"pele": "1.13.0",
		"xstate": "6.0.0-beta.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/vitest-plugin": "^1.6.0",
		"@oxlint/plugins": "1.93.0",
		"@tailwindcss/cli": "^4.3.3",
		"lemmascript": "0.6.6",
		"oxlint": "1.93.0",
		"playwright": "^1.63.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.158.0"
	}
}
