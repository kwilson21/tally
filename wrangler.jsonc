{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tally",
	"main": "./src/index.tsx",
	// Set once at project start; bump deliberately, never automatically.
	"compatibility_date": "2026-09-22",
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	},
	// Runs before `wrangler dev` and `wrangler deploy`, so generated CSS and htmx always ship.
	// Watch only src/: the build writes into public/, which would otherwise retrigger itself.
	"build": {
		"command": "npm run build",
		"watch_dir": "src"
	},
	// Local-only placeholder ID. Each deployed environment names its own database below.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tally-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "DOCS", "bucket_name": "tally-local-docs" }],
	// "true" shows the demo banner and lets the nightly job reset the data. Production sets "false" below.
	"vars": {
		"DEMO": "true"
	},
	"env": {
		// The public demo (decision 26). Deploy with: npx wrangler deploy --env demo
		"demo": {
			"r2_buckets": [{ "binding": "DOCS", "bucket_name": "tally-demo-docs" }],
			// Served only here. Cloudflare creates the DNS record and certificate on deploy.
			"routes": [
				{ "pattern": "tally-demo.thesuperhuman.us", "custom_domain": true }
			],
			"workers_dev": false,
			"preview_urls": false,
			// The nightly reset (spec §9), demo only. 09:00 UTC is 4–5 am Eastern and 1–2 am Pacific, depending on daylight saving.
			"triggers": {
				"crons": ["0 9 * * *"]
			},
			// vars and d1_databases are not inherited from the top level, so they're repeated here.
			"vars": {
				"DEMO": "true"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tally-demo",
					"database_id": "ce0d954f-0f85-46bf-9a25-0890c589e383",
					"migrations_dir": "migrations"
				}
			]
		},
		// The family's app (#23). Deploy with: npx wrangler deploy --env production (owner-approved only).
		// Cloudflare Access guards every path but /webhooks/plaid. Secrets and Plaid settings are set with
		// `wrangler secret put --env production`, never here.
		"production": {
			"r2_buckets": [{ "binding": "DOCS", "bucket_name": "tally-prod-docs" }],
			"routes": [
				{ "pattern": "tally.thesuperhuman.us", "custom_domain": true }
			],
			"workers_dev": false,
			"preview_urls": false,
			// The daily catch-up sync (spec §4), at the demo's hour.
			"triggers": {
				"crons": ["0 9 * * *"]
			},
			// Not the demo: no banner, and the nightly reset can never run (decision 25).
			"vars": {
				"DEMO": "false"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tally-production",
					"database_id": "97a4d15e-58a4-4067-b74e-6101195c6493",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
