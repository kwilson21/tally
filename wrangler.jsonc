{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tally",
	"main": "./src/index.tsx",
	// Set once at project start; bump deliberately, never automatically.
	"compatibility_date": "2026-09-22",
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	},
	// Runs before `wrangler dev` and `wrangler deploy`, so generated CSS and htmx always ship.
	// Watch only src/: the build writes into public/, which would otherwise retrigger itself.
	"build": {
		"command": "npm run build",
		"watch_dir": "src"
	},
	// Local-only placeholder ID. Real demo/production databases are created in Phase 1d
	// (wrangler d1 create) and set per environment.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tally-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// "true" shows the demo banner and lets the nightly job reset the data. Production sets "false" in Phase 1d.
	"vars": {
		"DEMO": "true"
	}
}
