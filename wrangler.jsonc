{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tally",
	"main": "./src/index.tsx",
	// Set once at project start; bump deliberately, never automatically.
	"compatibility_date": "2026-09-22",
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	},
	// Runs before `wrangler dev` and `wrangler deploy`, so generated CSS and htmx always ship.
	// Watch only src/: the build writes into public/, which would otherwise retrigger itself.
	"build": {
		"command": "npm run build",
		"watch_dir": "src"
	},
	// Sorting runs as a Workflow (decision 139). Names are unique per account, one per environment.
	"workflows": [
		{
			"binding": "SORT",
			"name": "tally-sort",
			"class_name": "SortWorkflow",
			"default_retention": {
				"success_retention": "3 days",
				"error_retention": "3 days"
			}
		}
	],
	// Local-only placeholder ID. Each deployed environment names its own database below.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tally-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// "true" shows the demo banner and lets the nightly job reset the data. Production sets "false" below.
	"vars": {
		"DEMO": "true"
	},
	"env": {
		// The public demo (decision 26). Deploy with: npx wrangler deploy --env demo --message "demo <short sha>" --var "APP_VERSION:demo <short sha>"
		"demo": {
			// Served only here. Cloudflare creates the DNS record and certificate on deploy.
			"routes": [
				{ "pattern": "tally-demo.thesuperhuman.us", "custom_domain": true }
			],
			"workers_dev": false,
			"preview_urls": false,
			// The nightly reset (spec §9), demo only, which also sorts and names in the one run. 09:00 UTC is 4–5 am Eastern and 1–2 am Pacific, depending on daylight saving.
			"triggers": {
				"crons": ["0 9 * * *"]
			},
			// vars and d1_databases are not inherited from the top level, so they're repeated here.
			"vars": {
				"DEMO": "true"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tally-demo",
					"database_id": "ce0d954f-0f85-46bf-9a25-0890c589e383",
					"migrations_dir": "migrations"
				}
			],
			"workflows": [
				{
					"binding": "SORT",
					"name": "tally-demo-sort",
					"class_name": "SortWorkflow",
					"default_retention": {
						"success_retention": "3 days",
						"error_retention": "3 days"
					}
				}
			],
			// Workers AI suggests merchant names in the demo too (spec §4.1), after each nightly reset.
			"ai": { "binding": "AI" }
		},
		// The family's app (#23). Deploy with: npx wrangler deploy --env production --message "vYYYY.MM.DD <short sha>" --var "APP_VERSION:vYYYY.MM.DD <short sha>" (owner-approved only, README "Versions and releases").
		// Cloudflare Access guards every path but /webhooks/plaid. Secrets and Plaid settings are set with
		// `wrangler secret put --env production`, never here.
		"production": {
			"send_email": [{ "name": "EMAIL" }],
			"routes": [
				{ "pattern": "tally.thesuperhuman.us", "custom_domain": true }
			],
			"workers_dev": false,
			"preview_urls": false,
			// Two runs a morning (decision 139): 09:00 the daily catch-up sync (spec §4), at the demo's hour, which then starts
			// the night's Workflow (sort everything waiting, then clear the daily run's wait mark, then names and suggestions) and
			// retries feedback; 10:00 the reconnect reminders, in their own invocation, then the ready email as a backstop. Each minute the
			// ready email alone (decision 146): a new family's email goes out once its person has left the first-week pages.
			// src/index.tsx routes by these exact strings.
			"triggers": {
				"crons": ["0 9 * * *", "0 10 * * *", "* * * * *"]
			},
			// Not the demo: no banner, and the nightly reset can never run (decision 25).
			"vars": {
				"DEMO": "false"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tally-production",
					"database_id": "97a4d15e-58a4-4067-b74e-6101195c6493",
					"migrations_dir": "migrations"
				}
			],
			"workflows": [
				{
					"binding": "SORT",
					"name": "tally-production-sort",
					"class_name": "SortWorkflow",
					"default_retention": {
						"success_retention": "3 days",
						"error_retention": "3 days"
					}
				}
			],
			// Workers AI suggests merchant names (spec §7, #33), only through src/ai/suggest-name.ts. It needs no
			// secret. Bindings aren't inherited, so it's repeated in each environment; the nightly job skips the step
			// where there is none. Local development has none: an AI binding always runs on Cloudflare's side, so at
			// the top level it would make every `npm test` and `npm run dev` open a remote connection and may incur
			// usage charges. Tests hand the code a fake `AI` instead.
			"ai": { "binding": "AI" }
		}
	}
}
